// Small widgets shared by the panel and the settings window.
import { Theme } from "theme.slint";

// A glyph button (the Segoe icon font): click, Enter or Space.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    callback clicked();

    width: Theme.icon-button-size;
    height: Theme.icon-button-size;
    border-radius: Theme.radius-control;
    background: touch.has-hover || focus.has-focus ? Theme.card : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: root.glyph;
        font-family: Theme.icon-font;
        font-size: Theme.font-icon;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // The click area is above the FocusScope: otherwise the first click only takes focus
    // (the FocusScope accepts the press while it isn't focused), and only the second one works.
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
