// Единственный источник цветов, отступов, радиусов и длительностей анимаций.
// Цвета — по токенам Windows 11 (Fluent) для флайаутов.

export global Theme {
    // Задаются из Rust по системным настройкам.
    in property <bool> dark: false;
    in property <color> accent: #0078d4;
    in property <string> font-family: "Segoe UI";
    in property <string> icon-font: "Segoe MDL2 Assets";

    // Окно
    out property <length> panel-width: 360px;
    // Задаётся из Rust: высота рабочей области монитора минус отступы (560px — до первого показа).
    in property <length> panel-max-height: 560px;
    out property <length> panel-margin: 12px;        // от края панели задач и экрана
    out property <length> panel-padding: 12px;

    // Окно настроек
    out property <length> settings-width: 720px;
    out property <length> settings-height: 520px;
    out property <length> settings-min-width: 600px;
    out property <length> settings-min-height: 440px;
    out property <length> settings-list-width: 220px;
    out property <length> settings-label-width: 180px;
    out property <length> settings-nav-width: 200px;
    out property <length> settings-nav-item-height: 36px;
    out property <length> settings-exe-field-width: 200px;
    out property <length> settings-combo-width: 160px;
    out property <length> nav-indicator-width: 3px;
    out property <length> nav-indicator-height: 16px;
    out property <length> font-title: 20px;

    // Отступы
    out property <length> spacing-xs: 4px;
    out property <length> spacing-s: 8px;
    out property <length> spacing-m: 12px;
    out property <length> spacing-l: 16px;

    // Радиусы
    out property <length> radius-card: 6px;
    out property <length> radius-control: 4px;
    out property <length> icon-button-size: 28px;
    out property <length> dpi-field-width: 76px;

    // Типографика
    out property <length> font-body: 14px;
    out property <length> font-caption: 12px;
    out property <length> font-icon: 16px;
    out property <int> weight-regular: 400;
    out property <int> weight-semibold: 600;

    // Глифы Segoe Fluent Icons / MDL2
    out property <string> glyph-mouse: "\u{E962}";
    out property <string> glyph-keyboard: "\u{E765}";
    out property <string> glyph-headset: "\u{E7F6}";
    out property <string> glyph-charging: "\u{E945}";
    out property <string> glyph-settings: "\u{E713}";
    out property <string> glyph-profiles: "\u{E77B}";
    out property <string> glyph-close: "\u{E711}";
    out property <string> glyph-edit: "\u{E70F}";
    out property <string> glyph-delete: "\u{E74D}";
    out property <string> glyph-refresh: "\u{E72C}";
    out property <string> glyph-add: "\u{E710}";
    out property <string> glyph-chevron-right: "\u{E76C}";
    out property <string> glyph-chevron-down: "\u{E70D}";

    // Цвета
    out property <color> background: dark ? #2c2c2c : #f9f9f9;
    out property <color> card: dark ? #ffffff0f : #ffffffb3;
    out property <color> card-disabled: dark ? #ffffff08 : #f9f9f94d;
    out property <color> card-stroke: dark ? #0000001a : #0000000f;
    out property <color> text-primary: dark ? #ffffff : #000000e4;
    out property <color> text-secondary: dark ? #ffffffc8 : #0000009e;
    out property <color> text-disabled: dark ? #ffffff5d : #0000005c;
    out property <color> divider: dark ? #ffffff15 : #0000000f;
    // Полоска заряда: дорожка, заполнение — акцент, низкий заряд — Fluent «critical».
    out property <color> battery-track: dark ? #ffffff1a : #0000001a;
    out property <color> battery-low: dark ? #ff99a4 : #c42b1c;
    out property <length> battery-bar-height: 4px;
    out property <length> radius-bar: 2px;
    // Цвета подсветки в палитре карточки клавиатуры и размер кружка.
    out property <[color]> swatches: [#ff8000, #ffffff, #ff0000, #00ff00, #0080ff, #8000ff];
    out property <length> swatch-size: 20px;
    out property <color> swatch-ring: dark ? #ffffff : #000000e4;
    out property <color> focus-ring: dark ? #ffffff : #000000e4;
    out property <color> error-text: dark ? #ff99a4 : #c42b1c;

    // Анимации
    out property <duration> anim-open: 150ms;
    out property <duration> anim-close: 100ms;
    out property <duration> anim-fast: 83ms;
    out property <length> anim-open-offset: 10px;
}
