// SPDX-License-Identifier: GPL-3.0-or-later
// The single source of colours, spacing, radii and animation durations.
// Colours follow the Windows 11 (Fluent) tokens for flyouts.

export global Theme {
    // Set from Rust from the system settings.
    in property <bool> dark: false;
    in property <color> accent: #0078d4;
    in property <string> font-family: "Segoe UI";
    in property <string> icon-font: "Segoe MDL2 Assets";

    // Window
    out property <length> panel-width: 360px;
    // Set from Rust: the monitor's work area height minus margins (560px until the first show).
    in property <length> panel-max-height: 560px;
    out property <length> panel-margin: 12px;        // from the taskbar edge and the screen edge
    out property <length> panel-padding: 12px;

    // Settings window
    out property <length> settings-width: 720px;
    out property <length> settings-height: 520px;
    out property <length> settings-min-width: 600px;
    out property <length> settings-min-height: 440px;
    out property <length> settings-list-width: 220px;
    out property <length> settings-label-width: 180px;
    out property <length> settings-nav-width: 200px;
    out property <length> settings-nav-item-height: 36px;
    out property <length> settings-exe-field-width: 200px;
    out property <length> settings-combo-width: 160px;
    // The device report preview in the "Advanced" section.
    out property <length> report-preview-height: 280px;
    // A device row in the "Devices" section (a fixed height: dragging is computed from it).
    out property <length> settings-device-row-height: 56px;
    // The custom colour editor in the keyboard card: preview, labels and values of the R/G/B sliders.
    out property <length> color-preview-size: 56px;
    out property <length> channel-label-width: 16px;
    out property <length> channel-value-width: 32px;
    // The equalizer in the headset card ("Devices" section): the height of the expanded part (fixed, since
    // the places of the rows below are computed from it), the height of the band sliders and the width of a band column.
    out property <length> eq-panel-height: 276px;
    // A device setting row under a "Devices" row (host, lift-off, auto power-off).
    out property <length> device-option-height: 44px;
    out property <length> eq-slider-height: 120px;
    out property <length> eq-band-width: 72px;
    // The key colour editor ("Devices" section, keyboard): the height of the expanded part, the layout
    // unit (the width of a normal key; smaller if the window is narrow), the gap between keys,
    // the labels on the keys.
    out property <length> key-editor-height: 256px;
    out property <length> key-unit: 26px;
    out property <length> key-gap: 2px;
    out property <length> key-font-size: 9px;
    out property <length> key-layout-combo-width: 88px;
    out property <length> nav-indicator-width: 3px;
    out property <length> nav-indicator-height: 16px;
    out property <length> font-title: 20px;

    // Spacing
    out property <length> spacing-xs: 4px;
    out property <length> spacing-s: 8px;
    out property <length> spacing-m: 12px;
    out property <length> spacing-l: 16px;

    // Radii
    out property <length> radius-card: 6px;
    out property <length> radius-control: 4px;
    out property <length> icon-button-size: 28px;
    out property <length> dpi-field-width: 76px;

    // Typography
    out property <length> font-body: 14px;
    out property <length> font-caption: 12px;
    out property <length> font-icon: 16px;
    out property <int> weight-regular: 400;
    out property <int> weight-semibold: 600;

    // Segoe Fluent Icons / MDL2 glyphs
    out property <string> glyph-mouse: "\u{E962}";
    out property <string> glyph-keyboard: "\u{E765}";
    out property <string> glyph-headset: "\u{E7F6}";
    out property <string> glyph-charging: "\u{E945}";
    // The connection in the card header: a USB plug and an antenna (wireless through a receiver).
    out property <string> glyph-usb: "\u{ECF0}";
    out property <string> glyph-wireless: "\u{E704}";
    out property <string> glyph-settings: "\u{E713}";
    out property <string> glyph-power: "\u{E7E8}";
    out property <string> glyph-profiles: "\u{E77B}";
    out property <string> glyph-close: "\u{E711}";
    out property <string> glyph-edit: "\u{E70F}";
    out property <string> glyph-delete: "\u{E74D}";
    out property <string> glyph-refresh: "\u{E72C}";
    out property <string> glyph-add: "\u{E710}";
    out property <string> glyph-report: "\u{E9D9}";
    out property <string> glyph-advanced: "\u{E90F}";
    out property <string> glyph-chevron-right: "\u{E76C}";
    out property <string> glyph-chevron-down: "\u{E70D}";
    out property <string> glyph-devices: "\u{E772}";
    out property <string> glyph-gripper: "\u{E76F}";
    out property <string> glyph-equalizer: "\u{E9E9}";
    out property <string> glyph-eraser: "\u{E75C}";

    // Colours
    out property <color> background: dark ? #2c2c2c : #f9f9f9;
    out property <color> card: dark ? #ffffff0f : #ffffffb3;
    out property <color> card-disabled: dark ? #ffffff08 : #f9f9f94d;
    out property <color> card-stroke: dark ? #0000001a : #0000000f;
    out property <color> text-primary: dark ? #ffffff : #000000e4;
    out property <color> text-secondary: dark ? #ffffffc8 : #0000009e;
    out property <color> text-disabled: dark ? #ffffff5d : #0000005c;
    out property <color> divider: dark ? #ffffff15 : #0000000f;
    // Battery: the fill is the accent, a low battery is Fluent "critical".
    out property <color> battery-low: dark ? #ff99a4 : #c42b1c;
    // The battery in the card header: body, "nub", the inset of the fill from the outline.
    out property <length> battery-width: 22px;
    out property <length> battery-height: 11px;
    out property <length> battery-cap-width: 2px;
    out property <length> battery-cap-height: 5px;
    out property <length> battery-inset: 2px;
    out property <length> radius-bar: 2px;
    // Lighting colours in the keyboard card's palette, and the circle size.
    out property <[color]> swatches: [#ff8000, #ffffff, #ff0000, #00ff00, #0080ff, #8000ff];
    out property <length> swatch-size: 20px;
    out property <color> swatch-ring: dark ? #ffffff : #000000e4;
    out property <color> focus-ring: dark ? #ffffff : #000000e4;
    out property <color> error-text: dark ? #ff99a4 : #c42b1c;
    // A key in the colour editor: colour unknown (the effect isn't static), labels on a light
    // and a dark key.
    out property <color> key-unlit: dark ? #ffffff14 : #00000014;
    out property <color> key-text-dark: #000000cc;
    out property <color> key-text-light: #ffffffdd;
    // The shadow of a card being dragged.
    out property <color> drag-shadow: dark ? #00000099 : #00000040;
    out property <length> drag-shadow-blur: 12px;

    // Animations
    out property <duration> anim-open: 150ms;
    out property <duration> anim-close: 100ms;
    out property <duration> anim-fast: 83ms;
    out property <length> anim-open-offset: 10px;
}
