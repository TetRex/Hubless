import { Button, ComboBox, LineEdit, Slider, Switch } from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { IconButton } from "../widgets.slint";

export enum DeviceKind { mouse, keyboard, headset }

export struct DeviceInfo {
    kind: DeviceKind,
    name: string,
    connected: bool,
    // Подключено кабелем (USB), иначе — по радио.
    wired: bool,
    // Заряд в процентах, -1 — неизвестен.
    battery: int,
    charging: bool,
    low: bool,
    // Мышь: текущий DPI (-1 — неизвестен) и быстрые кнопки.
    dpi: int,
    dpi-presets: [int],
    // Мышь: диапазон допустимых DPI (0 — неизвестен) для ползунка и поля.
    dpi-min: int,
    dpi-max: int,
    // Мышь: частота опроса, Гц (-1 — неизвестна), и быстрые кнопки.
    rate: int,
    rate-presets: [int],
    // Клавиатура: яркость (-1 — нет фичи) и её диапазон.
    brightness: int,
    brightness-min: int,
    brightness-max: int,
    // Эффект подсветки (индекс в списке effect-names; 0 — управляет сама клавиатура) и его цвет.
    effect: int,
    color: color,
    // Текущий цвет — один из своих цветов палитры (его можно убрать из палитры).
    color-custom: bool,
    // Гарнитура: sidetone 0–100; -1 — неизвестно.
    sidetone: int,
    // Ошибка последней записи.
    error: string,
}

// Заряд в заголовке карточки: значок зарядки, процент и батарейка с заливкой по заряду.
component BatteryIndicator inherits HorizontalLayout {
    in property <int> percent;
    in property <bool> charging;
    in property <bool> low;

    // Свободное место строки — имени устройства, а не промежуткам между процентом и батарейкой.
    horizontal-stretch: 0;
    alignment: end;
    spacing: Theme.spacing-xs;

    if root.charging: Text {
        text: Theme.glyph-charging;
        font-family: Theme.icon-font;
        font-size: Theme.font-caption;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    Text {
        text: root.percent + "%";
        font-size: Theme.font-caption;
        color: root.low ? Theme.battery-low : Theme.text-secondary;
        vertical-alignment: center;
    }

    // Корпус и «носик»; без обёртки раскладка растянула бы их на всю высоту строки.
    VerticalLayout {
        alignment: center;

        HorizontalLayout {
            Rectangle {
                width: Theme.battery-width;
                height: Theme.battery-height;
                border-width: 1px;
                border-radius: Theme.radius-bar;
                border-color: root.low ? Theme.battery-low : Theme.text-secondary;

                Rectangle {
                    x: Theme.battery-inset;
                    y: Theme.battery-inset;
                    width: (parent.width - 2 * Theme.battery-inset) * clamp(root.percent, 0, 100) / 100;
                    height: parent.height - 2 * Theme.battery-inset;
                    border-radius: Theme.radius-bar / 2;
                    background: root.low ? Theme.battery-low : Theme.accent;
                }
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: Theme.battery-cap-width;
                    height: Theme.battery-cap-height;
                    border-radius: Theme.radius-bar / 2;
                    background: root.low ? Theme.battery-low : Theme.text-secondary;
                }
            }
        }
    }
}

// Кружок цвета: клик, Enter или пробел выбирают цвет.
component Swatch inherits Rectangle {
    in property <color> value;
    in property <bool> selected;
    callback picked();

    width: Theme.swatch-size;
    height: Theme.swatch-size;
    border-radius: self.width / 2;
    background: value;
    border-width: selected ? 2px : 1px;
    border-color: selected || focus.has-focus ? Theme.swatch-ring : Theme.card-stroke;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.picked();
                return accept;
            }
            reject
        }
    }

    // Область клика поверх FocusScope: иначе первый клик только забирает фокус
    // (FocusScope принимает нажатие, пока не в фокусе), и срабатывает лишь второй.
    touch := TouchArea {
        clicked => {
            focus.focus();
            root.picked();
        }
    }
}

// Ползунок канала цвета 0–255: подпись, ползунок, значение.
component ChannelSlider inherits HorizontalLayout {
    in property <string> label;
    in-out property <int> value;

    spacing: Theme.spacing-s;

    Text {
        text: root.label;
        width: Theme.channel-label-width;
        font-size: Theme.font-caption;
        color: Theme.text-secondary;
        vertical-alignment: center;
    }

    Slider {
        horizontal-stretch: 1;
        minimum: 0;
        maximum: 255;
        value: root.value;
        changed(v) => {
            root.value = round(v);
        }
    }

    Text {
        text: root.value;
        width: Theme.channel-value-width;
        font-size: Theme.font-caption;
        color: Theme.text-primary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Кружок «+» в палитре: открыть редактор своего цвета.
component AddSwatch inherits Rectangle {
    in property <bool> active;
    callback clicked();

    width: Theme.swatch-size;
    height: Theme.swatch-size;
    border-radius: self.width / 2;
    background: touch.has-hover || focus.has-focus || root.active ? Theme.card : transparent;
    border-width: 1px;
    border-color: root.active || focus.has-focus ? Theme.swatch-ring : Theme.card-stroke;
    accessible-role: button;
    accessible-label: @tr("Add colour");
    accessible-action-default => {
        root.clicked();
    }

    Text {
        text: Theme.glyph-add;
        font-family: Theme.icon-font;
        font-size: Theme.font-caption;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // Поверх FocusScope — как у Swatch: иначе первый клик уходит на фокус.
    touch := TouchArea {
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

component Label inherits Text {
    font-size: Theme.font-caption;
    color: Theme.text-secondary;
    vertical-alignment: center;
}

// Карточка устройства. Отключённое устройство — свёрнутая серая карточка без контролов.
export component DeviceCard inherits Rectangle {
    in property <DeviceInfo> info;
    // Свои цвета палитры клавиатуры — второй ряд кружков — и их предел.
    in property <[color]> custom-colors;
    in property <int> max-colors;
    // Редактор своего цвета (кнопка «+»): открыт ли и значения ползунков.
    property <bool> editing-color;
    property <int> new-red;
    property <int> new-green;
    property <int> new-blue;
    // Можно ли добавить ещё цвет.
    property <bool> can-add: root.custom-colors.length < root.max-colors;

    function toggle-editor() {
        root.editing-color = !root.editing-color;
        if (root.editing-color) {
            root.new-red = info.color.red;
            root.new-green = info.color.green;
            root.new-blue = info.color.blue;
        }
    }
    callback select-dpi(int);
    callback drag-dpi(float);
    callback enter-dpi(float);
    callback select-rate(int);
    callback set-brightness(int);
    callback set-effect(int);
    callback pick-color(color);
    // Свой цвет: добавить в палитру (и включить) и убрать из неё.
    callback add-color(int, int, int);
    callback remove-color(color);
    callback set-sidetone(int);

    background: info.connected ? Theme.card : Theme.card-disabled;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-stroke;

    VerticalLayout {
        padding: Theme.spacing-m;
        spacing: Theme.spacing-s;

        HorizontalLayout {
            spacing: Theme.spacing-m;

            Text {
                text: info.kind == DeviceKind.mouse ? Theme.glyph-mouse
                    : info.kind == DeviceKind.keyboard ? Theme.glyph-keyboard
                    : Theme.glyph-headset;
                font-family: Theme.icon-font;
                font-size: Theme.font-icon;
                color: info.connected ? Theme.text-primary : Theme.text-disabled;
                vertical-alignment: center;
            }

            Text {
                text: info.name;
                font-weight: Theme.weight-semibold;
                color: info.connected ? Theme.text-primary : Theme.text-disabled;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            // Связь значком, заряд — в конце строки.
            if info.connected: Text {
                text: info.wired ? Theme.glyph-usb : Theme.glyph-wireless;
                font-family: Theme.icon-font;
                font-size: Theme.font-icon;
                color: Theme.text-secondary;
                vertical-alignment: center;
                accessible-label: info.wired ? @tr("USB") : @tr("Wireless");
            }

            if info.connected && info.battery >= 0: BatteryIndicator {
                percent: info.battery;
                charging: info.charging;
                low: info.low;
            }

            if !info.connected: Text {
                text: @tr("inactive");
                font-size: Theme.font-caption;
                color: Theme.text-disabled;
                vertical-alignment: center;
            }
        }

        // Мышь: быстрые кнопки DPI (новые мыши переводятся в режим host, G903 и др. — нет).
        if info.connected && info.kind == DeviceKind.mouse && info.dpi-presets.length > 0: HorizontalLayout {
            spacing: Theme.spacing-xs;

            Label {
                text: "DPI";
                min-width: self.preferred-width + Theme.spacing-s;
            }

            for v in info.dpi-presets: Button {
                text: v;
                primary: v == info.dpi;
                clicked => {
                    root.select-dpi(v);
                }
            }
        }

        // Мышь: любое значение DPI — ползунок в логарифмическом масштабе и поле ввода.
        // Значение подгоняется к допустимому в Rust; поле и ползунок следят за фактическим DPI.
        if info.connected && info.kind == DeviceKind.mouse && info.dpi-max > info.dpi-min: HorizontalLayout {
            spacing: Theme.spacing-s;

            dpi-slider := Slider {
                // Положение 0…1 ↔ DPI: min · (max / min) ^ положение.
                property <float> ratio: info.dpi-max / info.dpi-min;
                property <float> actual: info.dpi > 0 ? log(info.dpi / info.dpi-min, self.ratio) : 0;
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 1;
                value: self.actual;
                changed actual => {
                    self.value = self.actual;
                }
                changed(v) => {
                    let dpi = round(info.dpi-min * pow(self.ratio, v));
                    dpi-edit.text = dpi;
                    root.drag-dpi(dpi);
                }
            }

            dpi-edit := LineEdit {
                property <int> actual: info.dpi;
                width: Theme.dpi-field-width;
                input-type: number;
                horizontal-alignment: right;
                text: info.dpi > 0 ? info.dpi : "";
                changed actual => {
                    self.text = self.actual > 0 ? self.actual : "";
                }
                accepted(t) => {
                    root.enter-dpi(t.to-float());
                }
            }
        }

        // Мышь: частота опроса (новые мыши переводятся в режим host, G903 и др. — нет).
        if info.connected && info.kind == DeviceKind.mouse && info.rate-presets.length > 0: HorizontalLayout {
            spacing: Theme.spacing-xs;

            Label {
                text: @tr("Polling");
                min-width: self.preferred-width + Theme.spacing-s;
            }

            for hz in info.rate-presets: Button {
                text: hz >= 1000 ? (hz / 1000) + "K" : hz;
                primary: hz == info.rate;
                clicked => {
                    root.select-rate(hz);
                }
            }
        }

        // Значения без кнопок: список DPI или частот не прочитался.
        if info.connected && info.kind == DeviceKind.mouse && info.dpi > 0
            && info.dpi-presets.length == 0 && info.dpi-max <= info.dpi-min: HorizontalLayout {
            spacing: Theme.spacing-xs;

            Label {
                text: "DPI";
                min-width: self.preferred-width + Theme.spacing-s;
            }

            Text {
                text: info.dpi;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        if info.connected && info.kind == DeviceKind.mouse && info.rate > 0
            && info.rate-presets.length == 0: HorizontalLayout {
            spacing: Theme.spacing-xs;

            Label {
                text: @tr("Polling");
                min-width: self.preferred-width + Theme.spacing-s;
            }

            Text {
                text: @tr("{} Hz", info.rate);
                color: Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // Клавиатура: яркость.
        if info.connected && info.kind == DeviceKind.keyboard && info.brightness >= 0: HorizontalLayout {
            spacing: Theme.spacing-s;

            Label {
                text: @tr("Brightness");
            }

            Slider {
                horizontal-stretch: 1;
                minimum: info.brightness-min;
                maximum: info.brightness-max;
                value: info.brightness;
                changed(v) => {
                    root.set-brightness(round(v));
                }
            }
        }

        // Клавиатура: эффект подсветки (всё, кроме «Клавиатура», держит Hubless) и палитра.
        if info.connected && info.kind == DeviceKind.keyboard: HorizontalLayout {
            spacing: Theme.spacing-s;

            Label {
                text: @tr("Effect");
            }

            ComboBox {
                horizontal-stretch: 1;
                // Порядок совпадает с effect_by_index в app.rs.
                model: [@tr("Keyboard"), @tr("Static"), @tr("Breathe"), @tr("Cycle"), @tr("Wave"), @tr("Ripple")];
                current-index: info.effect;
                selected => {
                    root.set-effect(self.current-index);
                }
            }
        }

        // Палитра — для эффектов с цветом: статичный, дыхание, рябь. Свои цвета — вторым рядом,
        // «+» в конце последнего ряда открывает редактор своего цвета.
        if info.connected && info.kind == DeviceKind.keyboard
            && (info.effect == 1 || info.effect == 2 || info.effect == 5): VerticalLayout {
            spacing: Theme.spacing-s;

            HorizontalLayout {
                spacing: Theme.spacing-s;
                alignment: end;

                for c in Theme.swatches: Swatch {
                    value: c;
                    selected: c == info.color;
                    picked => {
                        root.pick-color(c);
                    }
                }

                if root.custom-colors.length == 0: AddSwatch {
                    active: root.editing-color;
                    clicked => {
                        root.toggle-editor();
                    }
                }
            }

            if root.custom-colors.length > 0: HorizontalLayout {
                spacing: Theme.spacing-s;
                alignment: end;

                for c in root.custom-colors: Swatch {
                    value: c;
                    selected: c == info.color;
                    picked => {
                        root.pick-color(c);
                    }
                }

                if root.can-add || root.editing-color: AddSwatch {
                    active: root.editing-color;
                    clicked => {
                        root.toggle-editor();
                    }
                }
            }

            // Редактор: предпросмотр и ползунки R/G/B; «Добавить» — в палитру и на клавиатуру.
            if root.editing-color: HorizontalLayout {
                spacing: Theme.spacing-m;

                Rectangle {
                    width: Theme.color-preview-size;
                    height: Theme.color-preview-size;
                    border-radius: Theme.radius-control;
                    border-width: 1px;
                    border-color: Theme.card-stroke;
                    background: rgb(root.new-red, root.new-green, root.new-blue);
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;

                    ChannelSlider {
                        label: "R";
                        value <=> root.new-red;
                    }

                    ChannelSlider {
                        label: "G";
                        value <=> root.new-green;
                    }

                    ChannelSlider {
                        label: "B";
                        value <=> root.new-blue;
                    }
                }
            }

            if root.editing-color: HorizontalLayout {
                spacing: Theme.spacing-s;
                alignment: end;

                if info.color-custom: IconButton {
                    glyph: Theme.glyph-delete;
                    label: @tr("Remove the selected colour from the palette");
                    clicked => {
                        root.remove-color(info.color);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: @tr("Add colour");
                    primary: true;
                    enabled: root.can-add;
                    clicked => {
                        root.add-color(root.new-red, root.new-green, root.new-blue);
                        root.editing-color = false;
                    }
                }
            }
        }

        // Гарнитура: свой голос в наушниках.
        if info.connected && info.kind == DeviceKind.headset && info.sidetone >= 0: HorizontalLayout {
            spacing: Theme.spacing-s;

            Label {
                text: @tr("Sidetone");
            }

            Slider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 100;
                value: info.sidetone;
                changed(v) => {
                    root.set-sidetone(round(v));
                }
            }
        }

        if info.connected && info.error != "": Text {
            text: info.error;
            font-size: Theme.font-caption;
            color: Theme.error-text;
            wrap: word-wrap;
        }
    }
}
