import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { DeviceCard, DeviceInfo, DeviceKind } from "cards/device_card.slint";
import { DeviceRow, EqBand, ProfileRow, SettingsWindow } from "settings.slint";

export { Theme, DeviceInfo, DeviceKind, DeviceRow, EqBand, ProfileRow, SettingsWindow }

export component Panel inherits Window {
    in property <[DeviceInfo]> devices;
    // Найдено хоть одно устройство (карточек может не быть — все скрыты).
    in property <bool> has-devices;
    // Свои цвета палитры клавиатуры (раздел настроек «Цвета клавиатуры»).
    in property <[color]> custom-colors;
    in property <int> max-colors;
    callback add-color(int, int, int);
    callback remove-color(color);
    // Фон Mica от DWM: окно прозрачное, иначе — сплошной цвет темы.
    in property <bool> backdrop;
    // Панель показана (содержимое проявляется) и включены ли системные «Эффекты анимации».
    in property <bool> shown;
    in-out property <bool> animated: true;
    // Профили настроек: имена и индекс действующего (список виден, если профилей больше одного).
    in property <[string]> profiles;
    in property <int> profile;
    callback select-profile(int);
    callback open-settings();
    // Высота по содержимому, не больше максимальной; выше — карточки прокручиваются.
    out property <length> content-height: min(
        Theme.panel-padding * 2 + header.preferred-height + Theme.spacing-s + cards.preferred-height,
        Theme.panel-max-height);
    // Esc — закрыть панель.
    callback dismiss();
    // Высота по содержимому изменилась (раскрыли «Ещё») — пересчитать положение у панели задач.
    callback resized();
    changed content-height => {
        root.resized();
    }
    // Действия карточек (мышь — DPI, клавиатура — яркость и подсветка).
    callback select-dpi(int);
    callback drag-dpi(float);
    callback enter-dpi(float);
    callback select-rate(int);
    callback set-brightness(int);
    callback set-effect(int);
    callback pick-color(color);
    callback set-sidetone(int);

    title: "Hubless";
    no-frame: true;
    always-on-top: true;
    width: Theme.panel-width;
    height: content-height;
    background: root.backdrop ? transparent : Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    keys := FocusScope {
        opacity: root.shown ? 1 : 0;
        animate opacity {
            duration: !root.animated ? 0ms : root.shown ? Theme.anim-open : Theme.anim-close;
            easing: ease-out;
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Theme.panel-padding;
            spacing: Theme.spacing-s;

            header := HorizontalLayout {
                padding-bottom: Theme.spacing-xs;
                spacing: Theme.spacing-s;

                Text {
                    text: "Hubless";
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.profiles.length > 1: ComboBox {
                    model: root.profiles;
                    current-index: root.profile;
                    selected => {
                        root.select-profile(self.current-index);
                    }
                }

                // Шестерёнка — окно настроек (язык, профили).
                IconButton {
                    glyph: Theme.glyph-settings;
                    label: @tr("Settings");
                    clicked => {
                        root.open-settings();
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: cards.preferred-height;

                cards := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    spacing: Theme.spacing-s;

                    // Карточек нет: устройств не найдено или все скрыты в настройках.
                    if root.devices.length == 0: Text {
                        text: root.has-devices
                            ? @tr("All devices are hidden. Choose which to show in Settings → Devices.")
                            : @tr("No Logitech devices found. Connect a device or its receiver.");
                        font-size: Theme.font-caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    for device in root.devices: DeviceCard {
                        info: device;
                        custom-colors: root.custom-colors;
                        max-colors: root.max-colors;
                        add-color(r, g, b) => {
                            root.add-color(r, g, b);
                        }
                        remove-color(c) => {
                            root.remove-color(c);
                        }
                        select-dpi(v) => {
                            root.select-dpi(v);
                        }
                        drag-dpi(v) => {
                            root.drag-dpi(v);
                        }
                        enter-dpi(v) => {
                            root.enter-dpi(v);
                        }
                        select-rate(hz) => {
                            root.select-rate(hz);
                        }
                        set-brightness(v) => {
                            root.set-brightness(v);
                        }
                        set-effect(i) => {
                            root.set-effect(i);
                        }
                        pick-color(c) => {
                            root.pick-color(c);
                        }
                        set-sidetone(v) => {
                            root.set-sidetone(v);
                        }
                    }
                }
            }
        }
    }
}
