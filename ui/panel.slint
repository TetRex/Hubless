import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { DeviceCard, DeviceInfo, DeviceKind } from "cards/device_card.slint";
import { DeviceRow, EqBand, ProfileRow, SettingsWindow } from "settings.slint";
import { KeyCap } from "keyboard_editor.slint";

export { Theme, DeviceInfo, DeviceKind, DeviceRow, EqBand, KeyCap, ProfileRow, SettingsWindow }

export component Panel inherits Window {
    in property <[DeviceInfo]> devices;
    // At least one device was found (there may be no cards: all are hidden).
    in property <bool> has-devices;
    // Your own keyboard palette colours (added with "+" in the keyboard card).
    in property <[color]> custom-colors;
    in property <int> max-colors;
    callback add-color(int, int, int);
    callback remove-color(color);
    // Mica background from DWM: the window is transparent, otherwise a solid theme colour.
    in property <bool> backdrop;
    // The panel is shown (the content fades in), and whether the system "Animation effects" are on.
    in property <bool> shown;
    in-out property <bool> animated: true;
    // Settings profiles: names and the index of the active one (the list is visible with more than one profile).
    in property <[string]> profiles;
    in property <int> profile;
    callback select-profile(int);
    callback open-settings();
    // Exit from Hubless (the tray icon has no menu).
    callback exit();
    // Height by content, no more than the maximum; beyond that the cards scroll.
    out property <length> content-height: min(
        Theme.panel-padding * 2 + header.preferred-height + Theme.spacing-s + cards.preferred-height,
        Theme.panel-max-height);
    // Esc closes the panel.
    callback dismiss();
    // The content height changed (a block was expanded): recompute the position at the taskbar.
    callback resized();
    changed content-height => {
        root.resized();
    }
    // Card actions (mouse: DPI; keyboard: brightness and lighting).
    callback select-dpi(int);
    callback drag-dpi(float);
    callback enter-dpi(float);
    callback select-rate(int);
    callback set-brightness(int);
    callback set-effect(int);
    callback pick-color(color);
    callback set-sidetone(int);
    callback select-eq-preset(int);

    title: "Hubless";
    no-frame: true;
    always-on-top: true;
    width: Theme.panel-width;
    height: content-height;
    background: root.backdrop ? transparent : Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    forward-focus: keys;

    keys := FocusScope {
        opacity: root.shown ? 1 : 0;
        animate opacity {
            duration: !root.animated ? 0ms : root.shown ? Theme.anim-open : Theme.anim-close;
            easing: ease-out;
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: Theme.panel-padding;
            spacing: Theme.spacing-s;

            header := HorizontalLayout {
                padding-bottom: Theme.spacing-xs;
                spacing: Theme.spacing-s;

                Text {
                    text: "Hubless";
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.profiles.length > 1: ComboBox {
                    model: root.profiles;
                    current-index: root.profile;
                    selected => {
                        root.select-profile(self.current-index);
                    }
                }

                // The gear opens the settings window.
                IconButton {
                    glyph: Theme.glyph-settings;
                    label: @tr("Settings");
                    clicked => {
                        root.open-settings();
                    }
                }

                // Exit: hands the lighting back to the keyboard and closes the app.
                IconButton {
                    glyph: Theme.glyph-power;
                    label: @tr("Exit");
                    clicked => {
                        root.exit();
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                content-height: cards.preferred-height;

                cards := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    spacing: Theme.spacing-s;

                    // No cards: no devices found, or all are hidden in the settings.
                    if root.devices.length == 0: Text {
                        text: root.has-devices
                            ? @tr("All devices are hidden. Choose which to show in Settings → Devices.")
                            : @tr("No Logitech devices found. Connect a device or its receiver.");
                        font-size: Theme.font-caption;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    for device in root.devices: DeviceCard {
                        info: device;
                        custom-colors: root.custom-colors;
                        max-colors: root.max-colors;
                        add-color(r, g, b) => {
                            root.add-color(r, g, b);
                        }
                        remove-color(c) => {
                            root.remove-color(c);
                        }
                        select-dpi(v) => {
                            root.select-dpi(v);
                        }
                        drag-dpi(v) => {
                            root.drag-dpi(v);
                        }
                        enter-dpi(v) => {
                            root.enter-dpi(v);
                        }
                        select-rate(hz) => {
                            root.select-rate(hz);
                        }
                        set-brightness(v) => {
                            root.set-brightness(v);
                        }
                        set-effect(i) => {
                            root.set-effect(i);
                        }
                        pick-color(c) => {
                            root.pick-color(c);
                        }
                        set-sidetone(v) => {
                            root.set-sidetone(v);
                        }
                        select-eq-preset(i) => {
                            root.select-eq-preset(i);
                        }
                    }
                }
            }
        }
    }
}
