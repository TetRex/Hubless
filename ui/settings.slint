// SPDX-License-Identifier: GPL-3.0-or-later
// The settings window: the section menu on the left, the section page on the right.
// "General": language, start with Windows, battery notifications, updates; "Devices": order and visibility
// of the panel cards and device settings; "Profiles": profile cards, the selected one expands;
// "Advanced": logs and the device report. Created on demand and destroyed when closed.
import { Button, ComboBox, LineEdit, ScrollView, Slider, Switch, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";
import { KeyboardEditor, KeyCap } from "keyboard_editor.slint";
import { DeviceKind } from "cards/device_card.slint";

// A headset equalizer band (prepared by Rust).
export struct EqBand {
    // «80 Hz», «2.2 kHz».
    label: string,
    // The vertical slider position = −gain, dB: it grows downwards, and "+" must be at the top.
    // The slider is bound to the field both ways and doesn't lose the link to the data (a preset was chosen).
    position: float,
}

// A device in the "Devices" section (prepared by Rust, in panel order).
export struct DeviceRow {
    kind: DeviceKind,
    name: string,
    connected: bool,
    // The card is visible in the panel.
    shown: bool,
    // Mouse: there is a host/onboard switch (not on the G903 and mice with the old features: host mode
    // disables the DPI button on the mouse), and its position.
    host-mode: bool,
    host: bool,
    // Mouse: lift-off, 1 medium, 2 high, 0 low; -1 if it can't or isn't connected.
    lift-off: int,
    // Headset: auto power-off, minutes, 0 = never; -1 if not read or not connected.
    auto-off: int,
    // Keyboard: single keys can be painted (connected, has `0x8081`).
    per-key: bool,
    // Keyboard: turn the lighting off after this many idle minutes, 0 = never; -1 if the keyboard
    // controls the lighting itself (or isn't connected).
    light-off: int,
}

// A profile for a card (prepared by Rust).
export struct ProfileRow {
    name: string,
    // The line under the name: bound programs, or an explanation for "Default".
    summary: string,
    programs: [string],
    active: bool,
    // "Default": no programs, can't be renamed or deleted.
    base: bool,
}

component Caption inherits Text {
    font-size: Theme.font-caption;
    color: Theme.text-secondary;
    vertical-alignment: center;
}

// A section menu item: icon and label; the selected one has an accent bar on the left.
component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: Theme.settings-nav-item-height;
    border-radius: Theme.radius-control;
    background: selected || touch.has-hover || focus.has-focus ? Theme.card : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-action-default => {
        root.clicked();
    }

    Rectangle {
        x: 0;
        width: Theme.nav-indicator-width;
        height: Theme.nav-indicator-height;
        border-radius: self.width / 2;
        background: root.selected ? Theme.accent : transparent;
    }

    HorizontalLayout {
        padding-left: Theme.spacing-m;
        padding-right: Theme.spacing-m;
        spacing: Theme.spacing-m;

        Text {
            text: root.glyph;
            font-family: Theme.icon-font;
            font-size: Theme.font-icon;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    // The click area is above the FocusScope: otherwise the first click only takes focus
    // (the FocusScope accepts the press while it isn't focused), and only the second one works.
    touch := TouchArea {
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

// A setting row on the "General" page: the label on the left, the control on the right.
component SettingRow inherits Rectangle {
    in property <string> label;

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-stroke;
    min-height: Theme.settings-nav-item-height + Theme.spacing-l;

    HorizontalLayout {
        padding-left: Theme.spacing-l;
        padding-right: Theme.spacing-l;
        spacing: Theme.spacing-m;

        Text {
            text: root.label;
            color: Theme.text-primary;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        @children
    }
}

// A device row: grip, icon, name and state, visibility in the panel; the mouse, keyboard and headset
// have a button that expands their settings under the row (host, lift-off; lighting, key colours; auto power-off, equalizer).
// The order is changed by dragging by any part of the card except the switch,
// or with ↑/↓ while the grip is focused (Tab).
component DeviceRowCard inherits Rectangle {
    in property <DeviceRow> device;
    // Bound to the model row both ways: the switch doesn't lose the link to the data
    // when rows swap places.
    in-out property <bool> shown;
    // The card is being dragged with the mouse right now.
    in property <bool> dragged;
    // Give focus back to the grip: the card was moved with the keyboard and is now in this place.
    in property <bool> want-focus;
    callback drag-start();
    // The pointer's vertical offset since the previous event.
    callback drag-move(length);
    callback drag-end();
    // An arrow on the grip: -1 up, 1 down.
    callback step(int);
    callback show(bool);
    // The device settings under the row: whether they are expanded, and their height (0: no settings; the window computes it).
    in property <bool> open;
    in property <length> settings-height;
    // Headset: the built-in equalizer, its bands and gain limits.
    in property <[EqBand]> eq-bands;
    in property <int> eq-min;
    in property <int> eq-max;
    // Equalizer presets: the list (the last one is "Custom" if the curve matches none of them),
    // the selected one and whether it is your own (your own can be deleted).
    in property <[string]> eq-presets;
    in-out property <int> eq-preset;
    in property <bool> eq-preset-custom;
    callback toggle-settings();
    callback set-host(bool);
    callback set-lift-off(int);
    callback set-auto-off(int);
    callback set-light-off(int);
    callback set-eq-band(int, int);
    callback select-eq-preset(int);
    callback save-eq-preset(string);
    callback delete-eq-preset(int);

    // Keyboard: the colour editor's keys, your own palette colours, whether key colours are visible, the layout
    // size in units; a click on a key and "Fill all".
    in property <[KeyCap]> keys;
    in property <[color]> custom-colors;
    in property <bool> keys-active;
    // The active profile (key colours and the equalizer curve are saved in it).
    in property <string> active-profile;
    in property <float> key-layout-width;
    in property <float> key-layout-height;
    in-out property <int> key-layout;
    callback paint-key(float, float, color, bool);
    callback fill-keys(color, bool);
    callback set-key-layout(int);

    // The name of a new preset is being entered (a name field instead of the list).
    property <bool> naming;
    property <string> new-preset-name;

    function finish-naming() {
        if (root.new-preset-name != "") {
            root.save-eq-preset(root.new-preset-name);
        }
        root.naming = false;
    }

    height: Theme.settings-device-row-height + (root.open ? root.settings-height : 0);
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.dragged || grip.has-focus ? Theme.accent : Theme.card-stroke;
    drop-shadow-blur: root.dragged ? Theme.drag-shadow-blur : 0;
    drop-shadow-color: Theme.drag-shadow;

    changed want-focus => {
        if (root.want-focus) {
            grip.focus();
        }
    }

    VerticalLayout {
        HorizontalLayout {
            height: Theme.settings-device-row-height;
            padding-left: Theme.spacing-s;
            padding-right: Theme.spacing-l;
            spacing: Theme.spacing-m;

            // Grip, icon and name; the drag area is on top of them.
            Rectangle {
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: Theme.spacing-s;

                    grip := FocusScope {
                        width: Theme.icon-button-size;
                        accessible-role: button;
                        accessible-label: @tr("Reorder: drag, or use the arrow keys");
                        key-pressed(event) => {
                            if (event.text == Key.UpArrow) {
                                root.step(-1);
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                root.step(1);
                                return accept;
                            }
                            reject
                        }

                        Text {
                            text: Theme.glyph-gripper;
                            font-family: Theme.icon-font;
                            font-size: Theme.font-icon;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.device.kind == DeviceKind.mouse ? Theme.glyph-mouse
                            : root.device.kind == DeviceKind.keyboard ? Theme.glyph-keyboard
                            : Theme.glyph-headset;
                        font-family: Theme.icon-font;
                        font-size: Theme.font-icon;
                        color: root.shown ? Theme.text-primary : Theme.text-disabled;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        padding-left: Theme.spacing-xs;

                        Text {
                            text: root.device.name;
                            color: root.shown ? Theme.text-primary : Theme.text-secondary;
                            overflow: elide;
                        }

                        Caption {
                            text: root.device.connected ? @tr("Connected") : @tr("Inactive");
                        }
                    }
                }

                TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.drag-start();
                        } else if ((event.button == PointerEventButton.left && event.kind == PointerEventKind.up)
                            || event.kind == PointerEventKind.cancel) {
                            root.drag-end();
                        }
                    }
                    // The card follows the pointer: `mouse-y` is measured from its new place.
                    moved => {
                        if (self.pressed) {
                            root.drag-move(self.mouse-y - self.pressed-y);
                        }
                    }
                }
            }

            if root.settings-height > 0: VerticalLayout {
                alignment: center;

                IconButton {
                    glyph: root.open ? Theme.glyph-chevron-down : Theme.glyph-chevron-right;
                    label: @tr("Settings");
                    clicked => {
                        root.toggle-settings();
                    }
                }
            }

            Switch {
                checked <=> root.shown;
                accessible-label: @tr("Show in the panel");
                toggled => {
                    root.show(self.checked);
                }
            }
        }

        // Mouse: the settings are applied by Hubless (host) or by the mouse's memory (onboard).
        if root.open && root.device.kind == DeviceKind.mouse && root.device.host-mode: HorizontalLayout {
            height: Theme.device-option-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-s;
            spacing: Theme.spacing-m;

            Text {
                text: @tr("Settings from Hubless (host)");
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Switch {
                checked: root.device.host;
                toggled => {
                    root.set-host(self.checked);
                }
            }
        }

        if root.open && root.device.kind == DeviceKind.mouse && root.device.lift-off >= 0: HorizontalLayout {
            height: Theme.device-option-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-s;
            spacing: Theme.spacing-xs;

            Text {
                text: "Lift-off";
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            // No "low": the PRO X 2 rejects lift-off 0 (INVALID_ARGUMENT, 2026-10-19).
            for name[i] in [@tr("medium"), @tr("high")]: Button {
                text: name;
                primary: i + 1 == root.device.lift-off;
                clicked => {
                    root.set-lift-off(i + 1);
                }
            }
        }

        // Keyboard: turning the lighting off after idle (while Hubless controls it). It can't be shorter than
        // 5 minutes: the keyboard itself reports idle, after 5 minutes on the PRO X TKL.
        if root.open && root.device.kind == DeviceKind.keyboard && root.device.light-off >= 0: HorizontalLayout {
            height: Theme.device-option-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-s;
            spacing: Theme.spacing-xs;

            Text {
                text: @tr("Turn off the lighting after");
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            for m in [5, 15, 30, 0]: Button {
                text: m == 0 ? @tr("never") : @tr("{} min", m);
                primary: m == root.device.light-off;
                clicked => {
                    root.set-light-off(m);
                }
            }
        }

        // Keyboard: colours of single keys.
        if root.open && root.device.kind == DeviceKind.keyboard && root.device.per-key: KeyboardEditor {
            height: Theme.key-editor-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-l;
            keys: root.keys;
            custom-colors: root.custom-colors;
            active: root.keys-active;
            profile: root.active-profile;
            layout-width: root.key-layout-width;
            layout-height: root.key-layout-height;
            layout <=> root.key-layout;
            set-layout(i) => {
                root.set-key-layout(i);
            }
            paint(x, y, c, erase) => {
                root.paint-key(x, y, c, erase);
            }
            fill(c, erase) => {
                root.fill-keys(c, erase);
            }
        }

        // Headset: auto power-off without sound.
        if root.open && root.device.kind == DeviceKind.headset && root.device.auto-off >= 0: HorizontalLayout {
            height: Theme.device-option-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-s;
            spacing: Theme.spacing-xs;

            Text {
                text: @tr("Turn off when silent");
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            for m in [0, 10, 30, 60]: Button {
                text: m == 0 ? @tr("never") : @tr("{} min", m);
                primary: m == root.device.auto-off;
                clicked => {
                    root.set-auto-off(m);
                }
            }
        }

        // Equalizer: a description, presets (choose, delete your own, "Save as preset"),
        // and the band sliders under them.
        if root.open && root.device.kind == DeviceKind.headset && root.eq-bands.length > 0: VerticalLayout {
            height: Theme.eq-panel-height;
            padding-left: Theme.spacing-l;
            padding-right: Theme.spacing-l;
            padding-bottom: Theme.spacing-l;
            spacing: Theme.spacing-s;

            Caption {
                text: @tr("The headset's built-in equalizer. The curve is saved in the profile “{}” and in the headset itself, so it also works without Hubless.", root.active-profile);
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.spacing-s;

                if !root.naming: ComboBox {
                    horizontal-stretch: 1;
                    model: root.eq-presets;
                    current-index <=> root.eq-preset;
                    selected => {
                        root.select-eq-preset(self.current-index);
                    }
                }

                if !root.naming && root.eq-preset-custom: IconButton {
                    glyph: Theme.glyph-delete;
                    label: @tr("Delete preset");
                    clicked => {
                        root.delete-eq-preset(root.eq-preset);
                    }
                }

                if !root.naming: Button {
                    text: @tr("Save as preset");
                    clicked => {
                        root.new-preset-name = "";
                        root.naming = true;
                    }
                }

                if root.naming: LineEdit {
                    horizontal-stretch: 1;
                    placeholder-text: @tr("Preset name");
                    text <=> root.new-preset-name;
                    init => {
                        self.focus();
                    }
                    accepted => {
                        root.finish-naming();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            root.naming = false;
                            return accept;
                        }
                        reject
                    }
                }

                if root.naming: Button {
                    text: @tr("Save");
                    primary: true;
                    enabled: root.new-preset-name != "";
                    clicked => {
                        root.finish-naming();
                    }
                }

                if root.naming: Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.naming = false;
                    }
                }
            }

            HorizontalLayout {
                alignment: space-around;
                vertical-stretch: 1;

                for band[i] in root.eq-bands: VerticalLayout {
                    width: Theme.eq-band-width;
                    spacing: Theme.spacing-xs;
                    alignment: center;

                    Text {
                        text: (band.position < 0 ? "+" : "") + round(-band.position) + " dB";
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;

                        Slider {
                            orientation: vertical;
                            height: Theme.eq-slider-height;
                            // A vertical slider grows downwards, so we invert it to have "+" at the top.
                            minimum: -root.eq-max;
                            maximum: -root.eq-min;
                            step: 1;
                            value <=> band.position;
                            changed(v) => {
                                root.set-eq-band(i, -round(v));
                            }
                        }
                    }

                    Caption {
                        text: band.label;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

// A profile card; the selected one is expanded.
component ProfileCard inherits Rectangle {
    in property <ProfileRow> profile;
    in property <bool> expanded;
    // Options for adding: the first is a hint, the others are running programs.
    in property <[string]> running;
    callback select();
    callback make-active();
    callback rename(string);
    callback delete();
    callback add-program(string);
    callback remove-program(string);
    callback refresh-running();

    property <bool> editing;

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.expanded ? Theme.accent : Theme.card-stroke;

    // Under the content: a click on an empty part of the card selects it.
    TouchArea {
        clicked => {
            root.select();
        }
    }

    VerticalLayout {
        padding: Theme.spacing-l;
        spacing: Theme.spacing-s;

        HorizontalLayout {
            spacing: Theme.spacing-s;

            if !root.editing: Text {
                text: root.profile.name;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if root.editing: name-edit := LineEdit {
                horizontal-stretch: 1;
                text: root.profile.name;
                init => {
                    self.focus();
                    self.select-all();
                }
                accepted(t) => {
                    root.editing = false;
                    root.rename(t);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editing = false;
                        return accept;
                    }
                    reject
                }
            }

            if root.profile.active: Text {
                text: @tr("Active");
                font-size: Theme.font-caption;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }

        Caption {
            text: root.profile.summary;
            wrap: word-wrap;
        }

        // The expanded card: programs, adding one, actions.
        if root.expanded && !root.profile.base: VerticalLayout {
            spacing: Theme.spacing-xs;
            padding-top: Theme.spacing-s;

            for exe in root.profile.programs: HorizontalLayout {
                spacing: Theme.spacing-s;

                Text {
                    text: exe;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                IconButton {
                    glyph: Theme.glyph-close;
                    label: @tr("Remove program");
                    clicked => {
                        root.remove-program(exe);
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-s;
                padding-top: Theme.spacing-xs;

                running-box := ComboBox {
                    horizontal-stretch: 1;
                    model: root.running;
                    current-index: 0;
                    selected(value) => {
                        if (self.current-index > 0) {
                            root.add-program(value);
                        }
                        self.current-index = 0;
                    }
                }

                IconButton {
                    glyph: Theme.glyph-refresh;
                    label: @tr("Refresh");
                    clicked => {
                        root.refresh-running();
                    }
                }

                LineEdit {
                    width: Theme.settings-exe-field-width;
                    placeholder-text: @tr("or type e.g. cs2.exe");
                    accepted(t) => {
                        root.add-program(t);
                        self.text = "";
                    }
                }
            }
        }

        // The bottom row only if it has actions (the active "Default" has none).
        if root.expanded && !(root.profile.active && root.profile.base): HorizontalLayout {
            spacing: Theme.spacing-s;
            padding-top: Theme.spacing-s;

            if !root.profile.active: Button {
                text: @tr("Make active");
                clicked => {
                    root.make-active();
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if !root.profile.base: IconButton {
                glyph: Theme.glyph-edit;
                label: @tr("Rename");
                clicked => {
                    root.editing = true;
                }
            }

            if !root.profile.base: IconButton {
                glyph: Theme.glyph-delete;
                label: @tr("Delete");
                clicked => {
                    root.delete();
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    // Section: 0 "General" (with updates), 1 "Devices", 2 "Profiles", 3 "Advanced"
    // (logs, device report).
    in-out property <int> page;
    // General
    in-out property <int> language;           // 0 English, 1 Russian
    in-out property <bool> autostart;
    // The low battery threshold (index in the list of options) and the "charged" notification.
    in property <[string]> low-battery-choices;
    in-out property <int> low-battery;
    in-out property <bool> notify-charged;
    // Devices in panel order.
    in property <[DeviceRow]> devices;
    // The headset's built-in equalizer (empty if the headset isn't connected) and the gain limits.
    in property <[EqBand]> eq-bands;
    in property <int> eq-min;
    in property <int> eq-max;
    // Equalizer presets: the list, the selected one, whether it is your own.
    in property <[string]> eq-presets;
    in-out property <int> eq-preset;
    in property <bool> eq-preset-custom;
    // Colours of single keys: the editor's keys, your own palette colours, whether key colours are visible
    // (static effect), the layout size in units.
    in property <[KeyCap]> keys;
    in property <[color]> custom-colors;
    in property <bool> keys-active;
    // The active profile: key colours and the equalizer curve are saved in it.
    in property <string> active-profile;
    in property <float> key-layout-width;
    in property <float> key-layout-height;
    // The keyboard layout in the editor: 0 ANSI, 1 ISO.
    in-out property <int> key-layout;
    // The "Devices" row with expanded device settings (-1: none).
    in-out property <int> open-row: -1;
    // Profiles: cards, the expanded one and options for adding a program (the first is a hint).
    in property <[ProfileRow]> profiles;
    in-out property <int> selected;
    in property <[string]> running;
    // The error message of the last action (empty: no error).
    in property <string> error;
    // Device report: collection in progress, the text and path of the finished report, the status line,
    // whether G Hub is running.
    in property <bool> report-busy;
    in property <string> report-text;
    in property <string> report-path;
    in property <string> report-status;
    in property <bool> ghub-running;
    // General: the Hubless version, the update check (in progress; the result; the new version's page, empty
    // if there is no update). Advanced: the result of actions with the logs.
    in property <string> version;
    in property <bool> update-busy;
    in property <string> update-status;
    in property <string> update-url;
    // Check for updates at startup.
    in-out property <bool> update-on-start;
    in property <string> logs-status;

    callback set-language(int);
    callback set-autostart(bool);
    callback set-low-battery(int);
    callback set-notify-charged(bool);
    callback set-update-on-start(bool);
    // A device by its index in the list: move it to a new place, show or hide it in the panel.
    // After a move, Rust sends the new order and calls finish-drop().
    callback move-device(int, int);
    callback show-device(int, bool);
    // Device settings (by row index): mouse host mode, lift-off, headset auto power-off.
    callback set-mouse-host(bool);
    callback set-lift-off(int);
    callback set-auto-off(int);
    // Turning the keyboard lighting off, idle minutes (0 = never).
    callback set-light-off(int);
    // An equalizer band: number and gain, dB. Preset: choose one (index in the list), save
    // the current curve under a name, delete your own.
    callback set-eq-band(int, int);
    callback select-eq-preset(int);
    callback save-eq-preset(string);
    callback delete-eq-preset(int);
    // The key under a point (layout units), with the brush colour or the eraser; all keys.
    callback paint-key(float, float, color, bool);
    callback fill-keys(color, bool);
    callback set-key-layout(int);
    callback select-profile(int);
    callback create-profile();
    callback rename-profile(int, string);
    callback delete-profile(int);
    callback use-profile(int);
    callback add-program(int, string);
    callback remove-program(int, string);
    callback refresh-running();
    callback create-report();
    callback open-reports();
    callback copy-report();
    callback open-issue();
    callback check-updates();
    callback open-update();
    callback open-logs();
    callback delete-logs();

    // Dragging in the "Devices" section: the row pitch, which row is being dragged (-1: none),
    // its offset from its place and the place it will drop into.
    property <length> device-pitch: Theme.settings-device-row-height + Theme.spacing-s;
    property <int> drag-from: -1;
    property <length> drag-dy;
    property <int> drag-to: root.drag-from < 0 ? -1
        : max(0, min(root.devices.length - 1,
            round((root.drag-from * root.device-pitch + root.drag-dy) / root.device-pitch)));
    // The row was released; waiting for the new order from Rust (the rows stay as they were when released).
    property <bool> dropping;
    // The rows settle into place without animation (the new order arrived, the data is already in the rows).
    property <bool> instant;
    // The row to give focus back to after a move with the keyboard.
    property <int> focus-request: -1;

    // The height of the settings under row `i` (0 if the device has none): mouse host and lift-off,
    // keyboard lighting timeout and key colours, headset auto power-off and equalizer.
    pure function settings-height(i: int) -> length {
        if (i < 0 || i >= root.devices.length) {
            return 0;
        }
        if (root.devices[i].kind == DeviceKind.mouse) {
            return (root.devices[i].host-mode ? Theme.device-option-height : 0)
                + (root.devices[i].lift-off >= 0 ? Theme.device-option-height : 0);
        }
        if (root.devices[i].kind == DeviceKind.headset) {
            return (root.devices[i].auto-off >= 0 ? Theme.device-option-height : 0)
                + (root.eq-bands.length > 0 ? Theme.eq-panel-height : 0);
        }
        if (root.devices[i].kind == DeviceKind.keyboard) {
            return (root.devices[i].light-off >= 0 ? Theme.device-option-height : 0)
                + (root.devices[i].per-key ? Theme.key-editor-height : 0);
        }
        return 0;
    }

    // Expanded settings push the rows below down by their height.
    property <length> open-height: root.settings-height(root.open-row);

    pure function device-y(slot: int) -> length {
        return slot * root.device-pitch
            + (root.open-row >= 0 && slot > root.open-row ? root.open-height : 0);
    }

    // The place of row `i` while another one is dragged: the rows between the old and new place shift by one.
    pure function device-slot(i: int) -> int {
        if (root.drag-from < 0) {
            return i;
        }
        if (root.drag-from < i && i <= root.drag-to) {
            return i - 1;
        }
        if (root.drag-to <= i && i < root.drag-from) {
            return i + 1;
        }
        return i;
    }

    // Row `from` moves to place `to` (with animation); the new order goes to Rust.
    function drop(from: int, to: int) {
        root.dropping = true;
        root.drag-dy = (to - from) * root.device-pitch;
        root.move-device(from, to);
    }

    // Rust sent the new order: the rows already have the new data, so reset the offsets without animation.
    public function finish-drop() {
        root.instant = true;
        root.dropping = false;
        root.drag-from = -1;
        root.drag-dy = 0;
    }

    title: @tr("Hubless — Settings");
    preferred-width: Theme.settings-width;
    preferred-height: Theme.settings-height;
    min-width: Theme.settings-min-width;
    min-height: Theme.settings-min-height;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;

    HorizontalLayout {
        // Section menu.
        VerticalLayout {
            width: Theme.settings-nav-width;
            padding: Theme.spacing-m;
            spacing: Theme.spacing-xs;
            alignment: start;

            NavItem {
                glyph: Theme.glyph-settings;
                label: @tr("General");
                selected: root.page == 0;
                clicked => {
                    root.page = 0;
                }
            }

            NavItem {
                glyph: Theme.glyph-devices;
                label: @tr("Devices");
                selected: root.page == 1;
                clicked => {
                    root.page = 1;
                }
            }

            NavItem {
                glyph: Theme.glyph-profiles;
                label: @tr("Profiles");
                selected: root.page == 2;
                clicked => {
                    root.page = 2;
                }
            }

            NavItem {
                glyph: Theme.glyph-advanced;
                label: @tr("Advanced");
                selected: root.page == 3;
                clicked => {
                    root.page = 3;
                }
            }
        }

        // Section page.
        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.spacing-l;
            padding-left: 0;
            spacing: Theme.spacing-m;

            if root.page == 0: VerticalLayout {
                spacing: Theme.spacing-s;

                Text {
                    text: @tr("General");
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                }

                // Scrolling and sticking to the top: the rows don't stretch to the window height.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.spacing-s;

                        SettingRow {
                            label: @tr("Language");

                            // Centred in the row and at its own height (otherwise the layout stretches it over the whole row).
                            VerticalLayout {
                                alignment: center;

                                ComboBox {
                                    width: Theme.settings-combo-width;
                                    // Language names aren't translated: each one is in its own language.
                                    model: ["English", "Русский"];
                                    current-index: root.language;
                                    selected => {
                                        root.language = self.current-index;
                                        root.set-language(self.current-index);
                                    }
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("Start with Windows");

                            Switch {
                                checked: root.autostart;
                                toggled => {
                                    root.autostart = self.checked;
                                    root.set-autostart(self.checked);
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("Low battery warning below");

                            VerticalLayout {
                                alignment: center;

                                ComboBox {
                                    width: Theme.settings-combo-width;
                                    model: root.low-battery-choices;
                                    current-index <=> root.low-battery;
                                    selected => {
                                        root.set-low-battery(self.current-index);
                                    }
                                }
                            }
                        }

                        SettingRow {
                            label: @tr("Notify when a device is fully charged");

                            Switch {
                                checked <=> root.notify-charged;
                                toggled => {
                                    root.set-notify-charged(self.checked);
                                }
                            }
                        }

                        // Updates: on the button and, if turned on, at startup; otherwise Hubless doesn't
                        // go online.
                        SettingRow {
                            label: @tr("Version {}", root.version);

                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: Theme.spacing-s;

                                    if root.update-url != "": Button {
                                        text: @tr("Download");
                                        primary: true;
                                        clicked => {
                                            root.open-update();
                                        }
                                    }

                                    Button {
                                        text: root.update-busy ? @tr("Checking…") : @tr("Check for updates");
                                        enabled: !root.update-busy;
                                        clicked => {
                                            root.check-updates();
                                        }
                                    }
                                }
                            }
                        }

                        Caption {
                            text: root.update-status != "" ? root.update-status
                                : @tr("Hubless connects to the internet only to check for updates: when you press the button, or at startup if that is on.");
                            wrap: word-wrap;
                        }

                        SettingRow {
                            label: @tr("Check for updates at startup");

                            Switch {
                                checked <=> root.update-on-start;
                                toggled => {
                                    root.set-update-on-start(self.checked);
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                spacing: Theme.spacing-s;

                Text {
                    text: @tr("Devices");
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                }

                Caption {
                    text: @tr("Drag devices to set their order in the panel, and choose which ones it shows. Hidden devices keep working with their settings.");
                    wrap: word-wrap;
                }

                if root.devices.length == 0: Caption {
                    text: @tr("No Logitech devices found. Connect a device or its receiver.");
                    wrap: word-wrap;
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        padding-top: Theme.spacing-xs;

                        // The rows stand in places by index; during a drag the others
                        // move apart, freeing the place where the dragged one will drop.
                        Rectangle {
                            height: max(0, root.devices.length * root.device-pitch - Theme.spacing-s
                                + root.open-height);

                            for item[i] in root.devices: DeviceRowCard {
                                x: 0;
                                width: parent.width;
                                y: i == root.drag-from ? i * root.device-pitch + root.drag-dy
                                    : root.device-y(root.device-slot(i));
                                z: i == root.drag-from ? 1 : 0;
                                // The card dragged with the mouse follows the pointer without delay.
                                animate y {
                                    duration: root.instant || (i == root.drag-from && !root.dropping)
                                        ? 0ms : Theme.anim-open;
                                    easing: ease-out;
                                }
                                device: item;
                                shown <=> item.shown;
                                dragged: i == root.drag-from && !root.dropping;
                                want-focus: i == root.focus-request;
                                open: i == root.open-row;
                                settings-height: root.settings-height(i);
                                eq-bands: root.eq-bands;
                                eq-min: root.eq-min;
                                eq-max: root.eq-max;
                                eq-presets: root.eq-presets;
                                eq-preset <=> root.eq-preset;
                                eq-preset-custom: root.eq-preset-custom;
                                keys: root.keys;
                                custom-colors: root.custom-colors;
                                keys-active: root.keys-active;
                                active-profile: root.active-profile;
                                key-layout-width: root.key-layout-width;
                                key-layout-height: root.key-layout-height;
                                key-layout <=> root.key-layout;
                                set-key-layout(i) => {
                                    root.set-key-layout(i);
                                }
                                paint-key(x, y, c, erase) => {
                                    root.paint-key(x, y, c, erase);
                                }
                                fill-keys(c, erase) => {
                                    root.fill-keys(c, erase);
                                }
                                toggle-settings => {
                                    root.instant = false;
                                    root.open-row = root.open-row == i ? -1 : i;
                                }
                                set-host(on) => {
                                    root.set-mouse-host(on);
                                }
                                set-lift-off(v) => {
                                    root.set-lift-off(v);
                                }
                                set-auto-off(m) => {
                                    root.set-auto-off(m);
                                }
                                set-light-off(m) => {
                                    root.set-light-off(m);
                                }
                                set-eq-band(band, gain) => {
                                    root.set-eq-band(band, gain);
                                }
                                select-eq-preset(index) => {
                                    root.select-eq-preset(index);
                                }
                                save-eq-preset(name) => {
                                    root.save-eq-preset(name);
                                }
                                delete-eq-preset(index) => {
                                    root.delete-eq-preset(index);
                                }
                                drag-start => {
                                    if (root.dropping) {
                                        return;
                                    }
                                    // Dragging computes row places for rows of equal height.
                                    root.open-row = -1;
                                    root.instant = false;
                                    root.focus-request = -1;
                                    root.drag-from = i;
                                    root.drag-dy = 0;
                                }
                                drag-move(delta) => {
                                    if (root.dropping || root.drag-from != i) {
                                        return;
                                    }
                                    root.drag-dy = max(-i * root.device-pitch,
                                        min((root.devices.length - 1 - i) * root.device-pitch,
                                            root.drag-dy + delta));
                                }
                                drag-end => {
                                    if (root.dropping || root.drag-from != i) {
                                        return;
                                    }
                                    if (root.drag-to == i) {
                                        // Not moved: the card returns to its place.
                                        root.drag-from = -1;
                                        root.drag-dy = 0;
                                        return;
                                    }
                                    root.drop(i, root.drag-to);
                                }
                                step(delta) => {
                                    if (root.dropping || i + delta < 0 || i + delta >= root.devices.length) {
                                        return;
                                    }
                                    root.instant = false;
                                    root.open-row = -1;
                                    root.drag-from = i;
                                    root.focus-request = i + delta;
                                    root.drop(i, i + delta);
                                }
                                show(on) => {
                                    root.show-device(i, on);
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 2: VerticalLayout {
                spacing: Theme.spacing-s;

                HorizontalLayout {
                    spacing: Theme.spacing-m;

                    Text {
                        text: @tr("Profiles");
                        font-size: Theme.font-title;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Button {
                        text: @tr("New profile");
                        clicked => {
                            root.create-profile();
                        }
                    }
                }

                Caption {
                    text: @tr("A profile switches on by itself while one of its programs is in the foreground.");
                    wrap: word-wrap;
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.spacing-s;
                        padding-top: Theme.spacing-xs;

                        for item[i] in root.profiles: ProfileCard {
                            profile: item;
                            expanded: i == root.selected;
                            running: root.running;
                            select => {
                                root.selected = i;
                                root.select-profile(i);
                            }
                            make-active => {
                                root.use-profile(i);
                            }
                            rename(name) => {
                                root.rename-profile(i, name);
                            }
                            delete => {
                                root.delete-profile(i);
                            }
                            add-program(exe) => {
                                root.add-program(i, exe);
                            }
                            remove-program(exe) => {
                                root.remove-program(i, exe);
                            }
                            refresh-running => {
                                root.refresh-running();
                            }
                        }
                    }
                }
            }

            if root.page == 3: VerticalLayout {
                spacing: Theme.spacing-s;

                Text {
                    text: @tr("Advanced");
                    font-size: Theme.font-title;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                }

                // Scrolling and sticking to the top: the blocks don't stretch to the window height.
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        alignment: start;
                        spacing: Theme.spacing-s;

                        SettingRow {
                            label: @tr("Logs");

                            VerticalLayout {
                                alignment: center;

                                HorizontalLayout {
                                    spacing: Theme.spacing-s;

                                    Button {
                                        text: @tr("Open log folder");
                                        clicked => {
                                            root.open-logs();
                                        }
                                    }

                                    Button {
                                        text: @tr("Delete all logs");
                                        clicked => {
                                            root.delete-logs();
                                        }
                                    }
                                }
                            }
                        }

                        if root.logs-status != "": Caption {
                            text: root.logs-status;
                            wrap: word-wrap;
                        }

                        Text {
                            text: @tr("Device report");
                            font-weight: Theme.weight-semibold;
                            color: Theme.text-primary;
                        }

                        Caption {
                            text: @tr("Help add support for your Logitech devices: create a report and send it as a GitHub issue. The report lists your Logitech devices and the HID++ features they support. It only reads from the devices, contains no serial numbers or personal data, and Hubless sends nothing by itself.");
                            wrap: word-wrap;
                        }

                        if root.ghub-running: Text {
                            text: @tr("G Hub is running: close it completely for an accurate report.");
                            color: Theme.error-text;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: Theme.spacing-s;
                            alignment: start;

                            Button {
                                text: root.report-busy ? @tr("Collecting…") : @tr("Create report");
                                primary: true;
                                enabled: !root.report-busy;
                                clicked => {
                                    root.create-report();
                                }
                            }

                            if root.report-text != "": Button {
                                text: @tr("Copy");
                                clicked => {
                                    root.copy-report();
                                }
                            }

                            if root.report-text != "": Button {
                                text: @tr("Open folder");
                                clicked => {
                                    root.open-reports();
                                }
                            }

                            if root.report-text != "": Button {
                                text: @tr("Open GitHub issue");
                                clicked => {
                                    root.open-issue();
                                }
                            }
                        }

                        if root.report-status != "": Caption {
                            text: root.report-status;
                            wrap: word-wrap;
                        }

                        if root.report-text != "": TextEdit {
                            height: Theme.report-preview-height;
                            read-only: true;
                            wrap: no-wrap;
                            text: root.report-text;
                        }
                    }
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.error-text;
                wrap: word-wrap;
            }
        }
    }
}
