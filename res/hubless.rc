#define RT_MANIFEST 24
1 RT_MANIFEST "hubless.exe.manifest"

// The exe icon is generated from src/tray/icon.rs (cargo test --release write_exe_icon -- --ignored).
1 ICON "hubless.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "TetRex"
      VALUE "FileDescription", "Hubless"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "hubless"
      VALUE "LegalCopyright", "Copyright (C) 2026 TetRex. GPL-3.0-or-later"
      VALUE "OriginalFilename", "hubless.exe"
      VALUE "ProductName", "Hubless"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
