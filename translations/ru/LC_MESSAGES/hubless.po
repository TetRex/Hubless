# Settings window
msgid "Hubless — Settings"
msgstr "Hubless — настройки"

msgid "General"
msgstr "Общие"

msgid "Language"
msgstr "Язык"

msgid "Start with Windows"
msgstr "Автозапуск"

msgid "Profiles"
msgstr "Профили"

msgid "Rename"
msgstr "Переименовать"

msgid "Make active"
msgstr "Сделать активным"

msgid "Delete"
msgstr "Удалить"

