msgid "A profile switches on by itself while one of its programs is in the foreground."
msgstr "Профиль включается сам, пока активна одна из его программ."

# Device report
msgid "Device report"
msgstr "Отчёт об устройствах"

msgid "Help add support for your Logitech devices: create a report and send it as a GitHub issue. The report lists your Logitech devices and the HID++ features they support. It only reads from the devices, contains no serial numbers or personal data, and Hubless sends nothing by itself."
msgstr "Помогите добавить поддержку ваших устройств Logitech: создайте отчёт и отправьте его через issue на GitHub. В отчёте — список ваших устройств Logitech и поддерживаемых ими функций HID++. Он только читает данные с устройств, не содержит серийных номеров и личных данных, а сам Hubless ничего никуда не отправляет."

msgid "G Hub is running: close it completely for an accurate report."
msgstr "Запущен G Hub: закройте его полностью, чтобы отчёт был точным."

msgid "Collecting…"
msgstr "Сбор…"

msgid "Create report"
msgstr "Создать отчёт"

msgid "Copy"
msgstr "Скопировать"

msgid "Open folder"
msgstr "Открыть папку"

msgid "Open GitHub issue"
msgstr "Открыть issue на GitHub"

# Settings window: devices
msgid "Devices"
msgstr "Устройства"

msgid "Drag devices to set their order in the panel, and choose which ones it shows. Hidden devices keep working with their settings."
msgstr "Перетащите устройства, чтобы задать их порядок в панели, и выберите, какие показывать. Скрытые устройства продолжают работать со своими настройками."

msgid "Connected"
msgstr "Подключено"

msgid "Inactive"
msgstr "Неактивно"

msgid "Reorder: drag, or use the arrow keys"
msgstr "Порядок: перетащите или нажимайте стрелки"

msgid "Show in the panel"
msgstr "Показывать в панели"

msgid "{} Hz"
msgstr "{} Гц"

# Panel: a custom colour in the keyboard palette
msgid "Add colour"
msgstr "Добавить цвет"

msgid "Remove the selected colour from the palette"
msgstr "Убрать выбранный цвет из палитры"

msgid "No Logitech devices found. Connect a device or its receiver."
msgstr "Устройства Logitech не найдены. Подключите устройство или его ресивер."

msgid "All devices are hidden. Choose which to show in Settings → Devices."
msgstr "Все устройства скрыты. Выбрать, какие показывать, — в «Настройки → Устройства»."

# Settings window, "Devices": the equalizer in the headset card
msgid "Equalizer"
msgstr "Эквалайзер"

msgid "The headset's built-in equalizer. The curve is saved in the profile “{}” and in the headset itself, so it also works without Hubless."
msgstr "Встроенный эквалайзер гарнитуры. Кривая сохраняется в профиле «{}» и в самой гарнитуре, поэтому работает и без Hubless."

# Equalizer presets: in the headset card ("Devices") and in the panel
msgid "Save as preset"
msgstr "Сохранить как пресет"

msgid "Preset name"
msgstr "Имя пресета"

msgid "Save"
msgstr "Сохранить"

msgid "Cancel"
msgstr "Отмена"

msgid "Delete preset"
msgstr "Удалить пресет"

# Keyboard card ("Devices"): turning the lighting off after idle
msgid "Turn off the lighting after"
msgstr "Гасить подсветку через"

# Colours of single keys: the editor in the keyboard card ("Devices")
msgid "Click or drag over keys to colour them. The colours are saved in the profile “{}”."
msgstr "Щёлкните по клавише или проведите по клавишам, чтобы покрасить их. Цвета сохраняются в профиле «{}»."

msgid "Key colours show with the Static effect: choose it in the keyboard card in the panel."
msgstr "Цвета клавиш видны со статичным эффектом: выберите его в карточке клавиатуры в панели."

msgid "Colour"
msgstr "Цвет"

msgid "Eraser: back to the effect colour"
msgstr "Ластик: вернуть цвет эффекта"

msgid "Fill all"
msgstr "Залить все"

msgid "Clear all"
msgstr "Очистить все"

# Panel: the connection icon in the card header (a label for screen readers)
msgid "USB"
msgstr "USB"

msgid "Wireless"
msgstr "Беспроводная связь"

# Settings window: "Advanced"
msgid "Advanced"
msgstr "Дополнительно"

msgid "Version {}"
msgstr "Версия {}"

msgid "Download"
msgstr "Скачать"

msgid "Checking…"
msgstr "Проверка…"

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Hubless connects to the internet only to check for updates: when you press the button, or at startup if that is on."
msgstr "Hubless выходит в интернет только для проверки обновлений: по кнопке или при запуске, если это включено."

msgid "Check for updates at startup"
msgstr "Проверять обновления при запуске"

msgid "Logs"
msgstr "Логи"

msgid "Open log folder"
msgstr "Открыть папку логов"

msgid "Delete all logs"
msgstr "Удалить все логи"
